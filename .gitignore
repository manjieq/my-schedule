# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
keystore.properties

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# AI-agent hint files — kept locally to help coding assistants, but not
# part of the repo itself (they carry no function for the app/build).
AGENTS.md
CLAUDE.md
.claude/

# iOS isn't built by this project — never generated, so nothing to track.
/ios

# android/ IS tracked (see keystore.properties above) — the signing config
# hand-edited into android/app/build.gradle needs to survive, so it can't
# be treated as a disposable `expo prebuild` output like /ios above.
# Only its own build artifacts/caches are ignored:
android/build/
android/app/build/
android/.gradle/
android/.kotlin/
android/local.properties
